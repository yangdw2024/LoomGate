    }
  },
  "bin": {
    "loomgate": "bin/loomgate.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/sdk.test.mjs"
  },
  "keywords": [
    "ai-gateway",
    "llm-gateway",
    "anthropic",
    "openai",
    "gemini",
    "mcp",
    "prompt-caching",
    "loomgate",
    "claude-code"
  ],
